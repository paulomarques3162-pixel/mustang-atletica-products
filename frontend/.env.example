# ============================================================
# Mustang Atlética — Frontend (Next.js no Vercel)
# Copie para .env.local (dev) ou configure no painel do Vercel.
# ============================================================

# URL pública da loja (usada em canonical, Open Graph, sitemap e share)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL da API (backend no Render em produção)
# Ex.: https://mustang-atletica-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Analytics (opcional). Sem valor, nenhum rastreamento é enviado.
NEXT_PUBLIC_ANALYTICS_ID=
