# ============================================================
# Mustang Atlética — API (backend)
# Copie para .env e preencha. NUNCA commite o .env real.
# ============================================================

# ---- Ambiente ----
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
LOG_LEVEL=info

# ---- Banco de dados (Neon PostgreSQL) ----
# DATABASE_URL usa o pooler (PgBouncer) do Neon
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/mustang?sslmode=require
# DIRECT_URL usa a conexão direta (necessária para migrations)
DIRECT_URL=postgresql://USUARIO:SENHA@HOST.REGIAO.aws.neon.tech/mustang?sslmode=require

# ---- Autenticação ----
JWT_SECRET=COLOQUE_UM_SEGREDO_LONGO_E_ALEATORIO
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- CORS (origens do frontend separadas por vírgula) ----
CORS_ORIGINS=http://localhost:3000

# ---- Pagamentos ----
# mock = APENAS desenvolvimento/testes. Proibido em produção.
# mercadopago | pagarme | asaas | stripe = requerem adapter oficial + credenciais
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_ENVIRONMENT=sandbox

# ---- Frete ----
# Enquanto não houver integração real de transportadora, a entrega só é
# liberada se uma taxa fixa for configurada. Sem isso, apenas retirada.
SHIPPING_FLAT_FEE=

# ---- Storage de imagens (NÃO usar disco local em produção) ----
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# ---- Seed (apenas desenvolvimento) ----
ALLOW_SEED=false
SEED_ADMIN_EMAIL=admin@mustang.local
SEED_ADMIN_PASSWORD=MustangDemo123
