# ============================================================
# Mustang Atlética — variáveis de ambiente (raiz)
#
# Este projeto é um monorepo com DOIS apps. Use os arquivos:
#   backend/.env          → variáveis da API (Render)
#   frontend/.env.local   → variáveis da loja (Vercel)
#
# As chaves abaixo resumem o que cada app precisa.
# NUNCA insira valores reais neste arquivo.
# ============================================================

# ---------- BACKEND (backend/.env) ----------
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=
DIRECT_URL=

JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_ENVIRONMENT=sandbox

SHIPPING_FLAT_FEE=

STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# ---------- FRONTEND (frontend/.env.local) ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ANALYTICS_ID=
